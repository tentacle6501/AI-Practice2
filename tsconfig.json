{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "prisma/seed.ts",
    "src/api/shared/asyncHandler.ts",
    "jest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
